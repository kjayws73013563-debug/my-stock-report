# ==============================================================================
# GitHub Pages 공유 준비용 .gitignore
# 민감정보, 개인문서, 인증 파일, 시스템 로그 및 비관련 작업 파일 배제
# ==============================================================================

# 1. 개인 인증 및 민감 보안 파일 (절대 커밋 금지)
.env
.env.*
*.key
*.pem
*.pfx
*.cert
*.crt
id_rsa
id_rsa.*
*.token
*credential*
*secret*
*password*

# 2. 시스템 및 IDE / 에이전트 로그 & 캐시
.system_generated/
brain/
logs/
*.log
*.tmp
*.bak
*.swp
*~

# 3. 운영체제 캐시 및 메타데이터
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# 4. 주식 보고서와 무관한 개인 작업 및 게임 폴더 (비공개 유지)
게임/
room_deco.html
snake_game.py
index_snake_backup.html

# 5. 하위 중복 폴더
주식/
